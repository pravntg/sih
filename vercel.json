{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "backend/src/main.py"
    },
    {
      "src": "/health",
      "dest": "backend/src/main.py"
    },
    {
      "src": "/docs",
      "dest": "backend/src/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "backend/src/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
